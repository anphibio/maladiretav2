APP_NAME="Sistema de Mala Direta TCE-AL"
APP_URL="http://localhost:3000"
APP_ENV="development"

DATABASE_URL="postgresql://maladireta:maladireta@localhost:5432/maladireta"
REDIS_URL="redis://localhost:6379"

ZIMBRA_DOMAIN="tceal.tc.br"
ZIMBRA_SMTP_HOST=""
ZIMBRA_SMTP_PORT="587"
ZIMBRA_SMTP_SECURE="false"
ZIMBRA_IMAP_HOST=""
ZIMBRA_IMAP_PORT="993"
ZIMBRA_IMAP_SECURE="true"
BOUNCE_IMAP_MAILBOX="INBOX"

SESSION_SECRET="change-me-with-a-long-random-secret"
JWT_SECRET="change-me-with-a-long-random-jwt-secret"
CREDENTIAL_ENCRYPTION_SECRET="change-me-with-a-long-random-credential-secret"

DEFAULT_MIN_EMAIL_DELAY_MS="20000"
DEFAULT_MAX_EMAIL_DELAY_MS="45000"
DEFAULT_PAUSE_EVERY_EMAILS="25"
DEFAULT_PAUSE_DURATION_MS="300000"
DEFAULT_HOURLY_EMAIL_LIMIT="90"
MAX_RECIPIENTS_PER_CAMPAIGN="5000"
QUEUE_DISPATCH_ENABLED="false"

# Lista separada por vírgula. Usuários autenticados no Zimbra com estes e-mails entram como ADMIN.
BOOTSTRAP_ADMIN_EMAILS="admin@tceal.tc.br"
CRON_SECRET="change-me-cron-secret"
